{
  "schemaVersion": 1,
  "id": "feathermorph-client",
  "version": "${version}",
  "name": "FeatherMorph",
  "description": "Client mod for the FeatherMorph plugin",
  "authors": ["MATRIX-feather"],
  "contact":
  {
    "sources": "https://github.com/XiaMoZhiShi/MorphPluginClient",
    "homepage": "https://github.com/XiaMoZhiShi"
  },
  "license": "MIT",
  "icon": "assets/morphclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "xyz.nifeather.morph.client.FeatherMorphClient"
    ],
    "modmenu":[
      "xyz.nifeather.morph.client.ModMenuApiImpl"
    ],
    "main":[
      "xyz.nifeather.morph.FeatherMorphFabricInitializer"
    ]
  },
  "mixins": [
    "client.mixins.json",
    "pipfix.mixins.json",
    "guifix.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": ">=1.21.5-rc.1",
    "cloth-config": ">=${clothconfig_version}"
  }
}
